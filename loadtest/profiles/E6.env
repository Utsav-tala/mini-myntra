# E6: failure during the peak. Deploy with defaults (bash infra/deploy.sh).
# About 6 minutes into the run (mid-peak), terminate one app instance in
# the EC2 console. The load balancer should route around it and the Auto
# Scaling Group should replace it, with no cascade.
SHAPE=sale
WARM_VUS=20
PEAK_VUS=250
WARM=2m
RAMP=1m
HOLD=15m
DOWN=2m
COOL=5m
THINK_MS=500
