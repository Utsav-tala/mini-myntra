# E1: one fixed server, load rising in steps until it breaks.
# Deploy with: MIN_SIZE=1 MAX_SIZE=1 bash infra/deploy.sh
# Read the result to choose PEAK_VUS for E2, E3, E5, E6: about 1.5x the
# step where p95 latency or errors start climbing.
SHAPE=step
STEP_VUS=25
STEP_TIME=2m
STEPS=10
THINK_MS=500
