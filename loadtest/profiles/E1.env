# E1: one fixed server, load rising in steps until it breaks.
# Deploy with: MIN_SIZE=1 MAX_SIZE=1 bash infra/deploy.sh
# Steps of 50 users up to 500: the Phase 2 scaling check saw one 2-worker
# t3.micro saturate near 640 req/s, so 250 users would not reach it.
# `python analysis/experiment.py process` prints the last healthy level and
# suggests PEAK_VUS for E2, E3, E5, E6 (about 1.5x that level).
SHAPE=step
STEP_VUS=50
STEP_TIME=2m
STEPS=10
THINK_MS=500
